root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{gd,c,cpp,h,mm}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[.clangd]
indent_size = 2
